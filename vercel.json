{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "hostelmanagementsystem": {
      "root": "HOSTEL MANAGEMENT SYSTEM",
      "framework": "flask",
      "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
      "functions": {
        "index.py": {
          "includeFiles": "frontend/dist/**"
        }
      },
      "rewrites": [
        {
          "source": "/combined",
          "destination": "/"
        },
        {
          "source": "/combined/:path*",
          "destination": "/:path*"
        }
      ]
    },
    "backend": {
      "root": "HOSTEL MANAGEMENT SYSTEM/backend",
      "framework": "flask"
    },
    "frontend": {
      "root": "HOSTEL MANAGEMENT SYSTEM/frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/combined",
      "destination": {
        "service": "hostelmanagementsystem"
      }
    },
    {
      "source": "/combined/(.*)",
      "destination": {
        "service": "hostelmanagementsystem"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
