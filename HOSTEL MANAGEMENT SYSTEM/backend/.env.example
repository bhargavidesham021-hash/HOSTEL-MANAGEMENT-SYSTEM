# Local: leave DATABASE_URL unset for SQLite.
# Production on Vercel: use Supabase's Transaction pooler URI (port 6543).
# Keep the real database password only in Vercel's server-side environment.
DATABASE_URL=
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Optional first-run owner bootstrap. Leave blank to create no owner account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Hostel Owner

FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
