# Local: leave DATABASE_URL unset for SQLite.
# Production: copy Supabase's Session pooler URI (or a reachable direct URI).
# Keep the real database password only in the backend host's environment settings.
DATABASE_URL=
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Optional first-run owner bootstrap. Leave blank to create no owner account.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Hostel Owner

FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Optional email delivery for admin password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
